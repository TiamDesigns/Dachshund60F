/*
 * Dachshund60F: Raytac MDBT50Q-1MV2 (nRF52840), 6x15 COL2ROW matrix,
 * one encoder, six SK6812MINI-E indicators.
 *
 * Every pin here comes from board.json; host-lib's board tests check that
 * the two agree.
 */

/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>
#include <zephyr/dt-bindings/led/led.h>
#include "dachshund60f-pinctrl.dtsi"

/ {
	model = "Dachshund60F";
	compatible = "dachshund,dachshund60f";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &code_partition;
	};

	aliases {
		led-strip = &led_strip;
	};

	/* TPS22917 load switch feeding the SK6812 chain (LED_EN, 100k pull-down). */
	led_power: led_power {
		compatible = "regulator-fixed";
		regulator-name = "led-vdd";
		enable-gpios = <&gpio0 8 GPIO_ACTIVE_HIGH>;
		startup-delay-us = <1000>;
	};

	/*
	 * Raw pin groups until the matrix, encoder and charger drivers exist
	 * (phases 3, 9 and 13). COL2ROW: columns are driven high, rows read with
	 * pull-downs.
	 */
	zephyr,user {
		matrix-row-gpios = <&gpio1 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
				   <&gpio1 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
				   <&gpio1 12 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
				   <&gpio1 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
				   <&gpio1 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
				   <&gpio1 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
		matrix-col-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>,
				   <&gpio0 3 GPIO_ACTIVE_HIGH>,
				   <&gpio0 28 GPIO_ACTIVE_HIGH>,
				   <&gpio0 29 GPIO_ACTIVE_HIGH>,
				   <&gpio0 30 GPIO_ACTIVE_HIGH>,
				   <&gpio0 31 GPIO_ACTIVE_HIGH>,
				   <&gpio1 1 GPIO_ACTIVE_HIGH>,
				   <&gpio1 2 GPIO_ACTIVE_HIGH>,
				   <&gpio1 3 GPIO_ACTIVE_HIGH>,
				   <&gpio1 4 GPIO_ACTIVE_HIGH>,
				   <&gpio1 5 GPIO_ACTIVE_HIGH>,
				   <&gpio1 6 GPIO_ACTIVE_HIGH>,
				   <&gpio1 7 GPIO_ACTIVE_HIGH>,
				   <&gpio0 4 GPIO_ACTIVE_HIGH>,
				   <&gpio0 5 GPIO_ACTIVE_HIGH>;
		encoder-a-gpios = <&gpio0 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		encoder-b-gpios = <&gpio0 12 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		charge-status-gpios = <&gpio0 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
	};
};

&uicr {
	gpio-as-nreset;
};

&gpiote {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

zephyr_udc0: &usbd {
	compatible = "nordic,nrf-usbd";
	status = "okay";
};

&spi3 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	pinctrl-0 = <&spi3_default>;
	pinctrl-1 = <&spi3_sleep>;
	pinctrl-names = "default", "sleep";

	/* Chain order (keyboard.json indicator ids): layer, battery 1-4, Caps Lock. */
	led_strip: ws2812@0 {
		compatible = "worldsemi,ws2812-spi";
		reg = <0>;
		spi-max-frequency = <4000000>;
		chain-length = <6>;
		color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
		spi-one-frame = <0x70>;
		spi-zero-frame = <0x40>;
	};
};

/*
 * Flash layout expected by the Adafruit nRF52 UF2 bootloader (SoftDevice
 * S140 v6.1.1 area kept free at the bottom, bootloader at the top).
 */
&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		sd_partition: partition@0 {
			label = "mbr-softdevice";
			reg = <0x00000000 0x00026000>;
			read-only;
		};

		code_partition: partition@26000 {
			label = "code_partition";
			reg = <0x00026000 0x000c6000>;
		};

		storage_partition: partition@ec000 {
			label = "storage";
			reg = <0x000ec000 0x00008000>;
		};

		boot_partition: partition@f4000 {
			label = "adafruit_boot";
			reg = <0x000f4000 0x0000c000>;
			read-only;
		};
	};
};
