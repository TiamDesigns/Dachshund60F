# Keyboard firmware options. USB IDs and strings must match
# boards/Dachshund60F/board.json (checked by the host-lib board tests).

menu "Dachshund60F keyboard"

config KB_USB_VID
	hex "USB vendor ID"
	default 0x1209
	help
	  pid.codes VID. The default PID below is a pid.codes TEST PID: not
	  unique, in-house testing only. Never ship it on a board that is
	  sold or redistributed.

config KB_USB_PID
	hex "USB product ID"
	default 0x0001

config KB_USB_MANUFACTURER
	string "USB manufacturer string"
	default "Dachshund"

config KB_USB_PRODUCT
	string "USB product string"
	default "Dachshund60F"

config KB_USB_MAX_POWER_MA
	int "USB bMaxPower in mA"
	default 500
	range 2 500
	help
	  The charger draws up to 500 mA from VBUS.

config KB_MODEL
	string "Keyboard definition name, reported to the host"
	default "Dachshund60F"
	help
	  The folder name under boards/; the configurator loads that
	  board's keyboard.json. At most 16 bytes.

config KB_BOOTLOADER_HOLD_MS
	int "Hold time for the recovery key (Esc) that reboots into UF2, in ms"
	default 3000
	help
	  Works from the physical key, whatever the keymap says, so a broken
	  keymap can always be reflashed. QK_BOOT in the keymap reboots at
	  once.

config KB_MATRIX_SCAN_PERIOD_US
	int "Matrix scan period, in microseconds"
	default 1000
	range 250 10000
	help
	  1000 scans at 1 kHz.

config KB_MATRIX_SETTLE_US
	int "Wait after driving a column before reading the rows, in microseconds"
	default 5
	range 0 100

config KB_MATRIX_RELEASE_US
	int "Longest wait for the rows to fall after releasing a column, in microseconds"
	default 10
	range 0 100
	help
	  The scan moves on as soon as every row reads low, so this only
	  costs time while a key in that column is pressed.

choice KB_DEBOUNCE_ALGO
	prompt "Debounce algorithm"
	default KB_DEBOUNCE_EAGER_PRESS
	help
	  See firmware/core/include/kb/debounce.h. The host can change this
	  at run time once the settings protocol exists (phase 10).

config KB_DEBOUNCE_EAGER_PRESS
	bool "Eager press, deferred release, per key"

config KB_DEBOUNCE_EAGER_PER_KEY
	bool "Eager, per key"

config KB_DEBOUNCE_DEFER_PER_KEY
	bool "Deferred, per key"

config KB_DEBOUNCE_EAGER_GLOBAL
	bool "Eager, whole matrix"

config KB_DEBOUNCE_DEFER_GLOBAL
	bool "Deferred, whole matrix"

endchoice

config KB_DEBOUNCE_MS
	int "Debounce time, in ms"
	default 5
	range 0 100

config KB_TAPPING_TERM_MS
	int "Tapping term for layer-tap and mod-tap keys, in ms"
	default 200
	range 50 2000

config KB_NKRO
	bool "N-key rollover at power-up"
	default y
	help
	  Keys go in the NKRO report on the extra HID interface. A host that
	  asks for boot protocol (a BIOS or KVM) always gets the 6-key boot
	  report. NK_TOGG in the keymap switches at run time; the host sets
	  it once the settings protocol exists (phase 10).

config KB_LED_SELFTEST
	bool "Walk the indicator LED chain once at power-up"
	default y
	help
	  One LED at a time in chain order, red, green then blue, 200 ms
	  each (3.6 s for six LEDs). Shows the chain and colour order at
	  bring-up; the indicators take over afterwards.

DT_CHOSEN_ZEPHYR_DISPLAY := zephyr,display

menuconfig KB_SCREEN
	bool "Status screen on the J4 display header"
	default $(dt_chosen_enabled,$(DT_CHOSEN_ZEPHYR_DISPLAY))
	select DISPLAY
	select CHARACTER_FRAMEBUFFER
	help
	  On by default when a panel overlay from firmware/displays/ is in
	  the build (it sets the zephyr,display chosen node).

if KB_SCREEN

config KB_SCREEN_TEXT
	string "Custom text shown under the status widgets"
	default "Dachshund60F"
	help
	  Up to 23 characters; longer text is cut off. Shown only when the
	  panel has a free row after the enabled status widgets.

config KB_SCREEN_SHOW_LAYER
	bool "Show the active layer"
	default y

config KB_SCREEN_SHOW_BATTERY
	bool "Show the battery level"
	default y

config KB_SCREEN_SHOW_LOCKS
	bool "Show Caps, Num and Scroll Lock"
	default y

config KB_SCREEN_SHOW_CONNECTION
	bool "Show the connection (USB, BT1-BT9, 2.4G)"
	default y

config KB_SCREEN_SHOW_TEXT
	bool "Show the custom text"
	default y

config KB_SCREEN_FONT_INDEX
	int "Character framebuffer font index (-1 picks the smallest)"
	default -1
	range -1 15

config KB_SCREEN_INVERT
	bool "Invert the screen (light text on dark e-paper, dark on lit OLED)"

config KB_SCREEN_EPD_MIN_INTERVAL_MS
	int "Minimum time between e-paper refreshes, in ms"
	default 3000
	range 500 600000
	help
	  E-paper refreshes are slow and wear the panel. Changes inside this
	  window are combined into one refresh. OLEDs ignore this.

config HEAP_MEM_POOL_ADD_SIZE_KB_SCREEN
	int
	default 8192
	help
	  The character framebuffer allocates the frame buffer from the heap.

endif # KB_SCREEN

endmenu

source "Kconfig.zephyr"
