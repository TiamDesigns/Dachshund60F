/*
 * USB HID interfaces exposed by the keyboard firmware, and by the dongle,
 * which uses this file too (report formats in
 * firmware/core/include/kb/hid.h):
 * - hid_kbd: boot keyboard, 8-byte 6KRO report and the lock-LED output
 * - hid_extra: NKRO keyboard, consumer and system control, with report IDs
 * - hid_config: the vendor-defined config interface (protocol/protocol.yaml),
 *   64-byte reports both ways over interrupt endpoints
 */

/ {
	hid_kbd: hid_kbd {
		compatible = "zephyr,hid-device";
		label = "Keyboard";
		protocol-code = "keyboard";
		in-report-size = <8>;
		in-polling-period-us = <1000>;
	};

	hid_extra: hid_extra {
		compatible = "zephyr,hid-device";
		label = "Keyboard NKRO and media";
		protocol-code = "none";
		in-report-size = <30>;
		in-polling-period-us = <1000>;
	};

	hid_config: hid_config {
		compatible = "zephyr,hid-device";
		label = "Dachshund config";
		protocol-code = "none";
		in-report-size = <64>;
		in-polling-period-us = <1000>;
		out-report-size = <64>;
		out-polling-period-us = <1000>;
	};
};
