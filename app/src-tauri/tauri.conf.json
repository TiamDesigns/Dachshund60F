{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Doghouse",
  "version": "../package.json",
  "identifier": "com.tiamdesigns.doghouse",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Doghouse",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Configurator for Dachshund keyboards",
    "longDescription": "Doghouse edits the keymap, advanced keys, macros, lights and settings of Dachshund keyboards over USB, Bluetooth or their 2.4 GHz dongle, and updates their firmware.",
    "license": "MIT",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "linux": {
      "deb": {
        "files": { "/usr/lib/udev/rules.d/70-dachshund.rules": "linux/70-dachshund.rules" }
      },
      "rpm": {
        "files": { "/usr/lib/udev/rules.d/70-dachshund.rules": "linux/70-dachshund.rules" }
      }
    }
  }
}
